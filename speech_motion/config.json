{
  "D": 0.5,
  "motion": {
    "transition": {
      "base_time": 0.5,
      "degrees_per_second": 15.0,
      "min_yaw_change": 3.0,
      "return_time": 0.5
    },
    "idle": {
      "interval": [2.5, 5.0],
      "yaw": [-6.0, 6.0],
      "pitch": [-2.0, 2.0]
    },
    "speaking": {
      "min_interval": 1.2,
      "yaw": [-10.0, 10.0],
      "pitch": [-3.0, 4.0]
    },
    "gestures": {
      "seconds_per_char": 0.2,
      "lead_time": 0.2,
      "min_interval": 1.5,
      "nod": {
        "keywords": ["是的", "是啊", "对的", "没错", "当然", "好的"],
        "prefixes": ["是", "对"],
        "amplitudes": [0, 5, 0, 3.5, 0],
        "segment_duration": 0.3
      },
      "shake": {
        "keywords": ["不是", "不对", "不行", "不可以"],
        "amplitudes": [0, 8, -6, 4, 0],
        "segment_duration": 0.5
      }
    }
  }
}
